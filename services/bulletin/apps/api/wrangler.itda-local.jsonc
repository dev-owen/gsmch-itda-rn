{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "itda-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "WEB_ORIGIN": "http://localhost:8081",
    "EXTRA_TRUSTED_ORIGINS": "http://localhost:5173,http://127.0.0.1:8081",
    "MOBILE_APP_ORIGIN": "itda://",
    "PUBLIC_MEDIA_BASE_URL": "http://localhost:8787/v1/media",
    "BETTER_AUTH_URL": "http://localhost:8787",
    "BULLETIN_SOURCE_ORIGIN": "https://gsmch-youth-bulletin.gsmch-youth-dev.workers.dev"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "itda-local-media"
    }
  ],
  "triggers": {
    "crons": [
      "0 0 * * MON"
    ]
  }
}
